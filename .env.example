APP_NAME="MediDesk AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PEARLIE_DEFAULT_HOSPITAL=pearl
# Set this to the shared tenant domain in production, for example medidesk.example.com.
TENANT_BASE_DOMAIN=localhost
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset to default to true in production; HTTPS is required.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail options (choose one):
# Recommended: Resend. Install/configure resend/resend-php (already in Composer dependencies).
# MAIL_MAILER=resend
# RESEND_API_KEY=
#
# Gmail SMTP: use a Google App Password (not your Google account password).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
#
# Mailgun: requires symfony/mailgun-mailer and symfony/http-client (in Composer dependencies).
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net
#
# Local development default: log mail to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GROQ_API_KEY=
GROQ_MODEL=groq/compound
ANTHROPIC_API_KEY=

# Notification / provider settings
PEARLIE_NOTIFICATION_RETRY_ATTEMPTS=3
PEARLIE_NOTIFICATION_BACKOFF_MS=500
PEARLIE_REPORT_NOTIFICATION_FAILURES=true

# Escalation / contact targets
ESCALATION_NOTIFICATION_EMAIL=frontdesk@pearlhospital.co.ke
ESCALATION_NOTIFICATION_PHONE=0707799114
PEARLIE_ESCALATION_PHONE=0707799114
PEARLIE_ESCALATION_WHATSAPP=254707799114
PEARLIE_ESCALATION_MAX_WAIT=30

# Africa's Talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=PearlHosp

# Twilio
# For API key authentication:
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
# Legacy auth names remain supported:
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERSION=v18.0

# M-Pesa Daraja (use sandbox credentials locally; never commit real secrets)
# These global values are the fallback for Pearl Hospital. Each hospital can
# configure its own encrypted credentials in the hospital onboarding screen.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/api/mpesa/callback"
MPESA_APPOINTMENT_DEPOSIT=500
MPESA_ACCOUNT_REFERENCE=PearlHospital
MPESA_TRANSACTION_DESCRIPTION="Pearl Hospital appointment booking"
MPESA_TIMEOUT=20
PEARLIE_HOSPITAL_NAME="Pearl Hospital"
PEARLIE_HOSPITAL_LOCATION="Vin Plaza, Nyahururu-Nyeri Road, Nyahururu, Kenya"
PEARLIE_HOSPITAL_EMAIL=info@pearlhospital.co.ke
PEARLIE_HOSPITAL_WEBSITE=https://www.pearlhospital.co.ke
PEARLIE_EMERGENCY_PHONE=0707799114
PEARLIE_APPOINTMENT_PHONE=0707799114
PEARLIE_WHATSAPP_NUMBER=254707799114
PEARLIE_DEPOSIT_AMOUNT=500
PEARLIE_SLOT_DURATION=30
PEARLIE_NO_SHOW_GRACE_MINUTES=30
PEARLIE_DOCTOR_ONE_NAME="Dr. John Kamau"
PEARLIE_DOCTOR_ONE_EMAIL=doctor1@pearlhospital.co.ke
PEARLIE_DOCTOR_ONE_SPECIALIZATION="General Medicine"
PEARLIE_DOCTOR_ONE_PHONE=0700000001
PEARLIE_DOCTOR_TWO_NAME="Dr. Mary Wanjiru"
PEARLIE_DOCTOR_TWO_EMAIL=doctor2@pearlhospital.co.ke
PEARLIE_DOCTOR_TWO_SPECIALIZATION=Pediatrics
PEARLIE_DOCTOR_TWO_PHONE=0700000002
PEARLIE_NO_SHOW_GRACE_MINUTES=30

# Registration and administrator provisioning
ALLOW_REGISTRATION=false
# Local db:seed demo accounts (password: password; never use outside development).
ADMIN_EMAIL=admin@pearlhospital.co.ke
ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=super@axiomforge.co.ke
# The development seeder defaults to "password" only outside production.
SUPER_ADMIN_PASSWORD=

# Optional Sentry DSN (if using Sentry for error reporting)
SENTRY_DSN=
